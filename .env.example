# Required. Generate your own value and never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Production only: trusted proxies in front of the app (client IP for rate limits)
# and the Azure Storage account that keeps uploaded pet photos.
# DJANGO_NUM_PROXIES=1
# Límite general de la API (por defecto 120/min sin sesión y 600/min con sesión).
# DJANGO_API_ANON_RATE=120/min
# DJANGO_API_USER_RATE=600/min
# DJANGO_HTTPS_ONLY=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER=media

# Use only the local Adopkia databases and application user.
DB_ENGINE=mysql
DB_NAME=adopkia
DB_USER=adopkia_dev
# Required for MySQL: the password you chose for adopkia_dev.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo saliente. Vacío: en debug el código de verificación sale en la consola.
# Con Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=la cuenta de Gmail y
# EMAIL_HOST_PASSWORD=una contraseña de aplicación (no la de la cuenta).
# Prueba el envío con: python manage.py send_test_email tu-correo@ejemplo.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Opcional; por defecto "Adopkia <EMAIL_HOST_USER>".
DEFAULT_FROM_EMAIL=
