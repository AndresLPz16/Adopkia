msgstr "Reminder: %(type)s for %(pet)s on %(date)s."

msgid "Tienes un recordatorio pendiente."
msgstr "You have a pending reminder."

msgid "Nuevo mensaje en una conversación sobre %(shelter)s."
msgstr "A new message in a conversation about %(shelter)s."

msgid "Tienes un mensaje nuevo."
msgstr "You have a new message."

msgid "Tu solicitud cambió de estado."
msgstr "Your request status changed."

msgid "Una solicitud de adopción fue cancelada."
msgstr "An adoption request was cancelled."

